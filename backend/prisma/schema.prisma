datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

enum user_global_role {
  developer
  head
  user

  @@schema("public")
}

enum org_member_role {
  head
  bendahara
  sekretaris
  member

  @@schema("public")
}

enum financial_type {
  income
  expense

  @@schema("public")
}

enum attendance_status {
  present
  absent
  late
  excused

  @@schema("public")
}

enum goal_status {
  active
  completed
  failed

  @@schema("public")
}

enum subscription_status {
  active
  past_due
  canceled
  unpaid

  @@schema("public")
}

model profiles {
  id                  String                 @id @db.Uuid
  email               String                 @unique
  full_name           String?
  avatar_url          String?
  global_role         user_global_role       @default(user)
  created_at          DateTime               @default(now()) @db.Timestamptz
  updated_at          DateTime               @updatedAt @db.Timestamptz
  organizations       organizations[]
  organization_members organization_members[]
  financial_records   financial_records[]
  attendance          attendance[]
  attendance_sessions attendance_sessions[]
  meeting_minutes     meeting_minutes[]
  goals               goals[]
  goal_transactions   goal_transactions[]
  subscriptions       subscriptions[]
  notifications       notifications[]
  push_subscriptions  push_subscriptions[]

  @@schema("public")
}

model organizations {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String                 @unique
  owner_id             String                 @db.Uuid
  logo_url             String?
  invite_code          String?                @unique
  dues_target_amount   Decimal?               @db.Decimal(15, 2)
  dues_presets         String?                @default("10000,20000,50000,100000")
  custom_fields_schema Json?
  created_at           DateTime               @default(now()) @db.Timestamptz
  updated_at           DateTime               @updatedAt @db.Timestamptz
  owner                profiles               @relation(fields: [owner_id], references: [id])
  organization_members organization_members[]
  financial_records   financial_records[]
  attendance          attendance[]
  attendance_sessions attendance_sessions[]
  meeting_minutes     meeting_minutes[]
  goals               goals[]

  @@schema("public")
}

model organization_members {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  profile_id      String          @db.Uuid
  role            org_member_role @default(member)
  custom_data     Json?
  joined_at       DateTime        @default(now()) @db.Timestamptz
  organization    organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  profile         profiles        @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, profile_id])
  @@schema("public")
}

model financial_records {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?         @db.Uuid
  profile_id      String          @db.Uuid
  amount          Decimal         @db.Decimal(15, 2)
  type            financial_type
  category        String
  description     String?
  receipt_url     String?
  transaction_date DateTime       @default(now()) @db.Date
  created_at      DateTime        @default(now()) @db.Timestamptz
  organization    organizations?  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  profile         profiles        @relation(fields: [profile_id], references: [id])

  @@schema("public")
}

model attendance {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  profile_id      String            @db.Uuid
  session_id      String?           @db.Uuid
  status          attendance_status @default(present)
  notes           String?
  proof_url       String?           // Bukti sakit/izin
  latitude        Float?
  longitude       Float?
  distance_meters Float?
  check_in_time   DateTime          @default(now()) @db.Timestamptz
  check_out_time  DateTime?         @db.Timestamptz
  created_at      DateTime          @default(now()) @db.Timestamptz
  
  organization    organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  profile         profiles          @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  session         attendance_sessions? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@schema("public")
}

model attendance_sessions {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  created_by      String        @db.Uuid
  title           String        @default("Sesi Absensi")
  session_type    String        @default("in_only") // 'in_only' atau 'in_out'
  pin_code        String        @db.VarChar(10)
  checkout_pin_code String?     @db.VarChar(10)
  latitude        Float
  longitude       Float
  radius_meters   Int           @default(50)
  start_time      DateTime      @default(now()) @db.Timestamptz
  end_time        DateTime      @default(now()) @db.Timestamptz
  checkout_start_time DateTime? @db.Timestamptz
  late_time       DateTime?     @db.Timestamptz
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now()) @db.Timestamptz
  closed_at       DateTime?     @db.Timestamptz
  
  organization    organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  creator         profiles      @relation(fields: [created_by], references: [id])
  attendance      attendance[]
  meeting_minutes meeting_minutes?

  @@schema("public")
}

model meeting_minutes {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  session_id      String?       @unique @db.Uuid
  title           String
  content         String        @db.Text
  ai_summary      String?       @db.Text
  created_by      String        @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz
  
  organization    organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  session         attendance_sessions? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  author          profiles      @relation(fields: [created_by], references: [id])

  @@schema("public")
}

model notifications {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id  String    @db.Uuid
  title       String
  body        String
  is_read     Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz
  
  profile     profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  @@schema("public")
}

model push_subscriptions {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id  String    @db.Uuid
  endpoint    String    @unique
  p256dh      String
  auth        String
  created_at  DateTime  @default(now()) @db.Timestamptz
  
  profile     profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  @@schema("public")
}

model goals {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?       @db.Uuid
  profile_id      String        @db.Uuid
  type            String        @default("saving") // "saving" (Target Tabungan) or "budget" (Batas Anggaran)
  budget_category String?       // Jika type="budget", ini menyimpan kategori pengeluaran (misal: "Konsumsi")
  period          String?       @default("monthly") // "monthly" atau "yearly"
  title           String
  description     String?
  target_amount   Decimal?      @db.Decimal(15, 2)
  current_amount  Decimal?      @default(0.00) @db.Decimal(15, 2)
  deadline        DateTime?     @db.Date
  status          goal_status   @default(active)
  created_at      DateTime      @default(now()) @db.Timestamptz
  organization    organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  profile         profiles      @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  goal_transactions goal_transactions[]

  @@schema("public")
}

model goal_transactions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goal_id    String   @db.Uuid
  profile_id String   @db.Uuid
  amount     Decimal  @db.Decimal(15, 2)
  type       String   @default("income") // 'income', 'expense', or 'transfer_out'
  source     String   // 'kas' or 'eksternal' (atau bisa jadi 'target' jika pindahan)
  description String?
  created_at DateTime @default(now()) @db.Timestamptz

  goal    goals    @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  profile profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

model subscriptions {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id              String              @db.Uuid
  pakasir_subscription_id String?             @unique
  status                  subscription_status @default(active)
  plan_type               String
  payment_url             String?
  amount_paid             Decimal?            @db.Decimal(15, 2)
  starts_at               DateTime            @db.Timestamptz
  expires_at              DateTime            @db.Timestamptz
  created_at              DateTime            @default(now()) @db.Timestamptz
  updated_at              DateTime            @updatedAt @db.Timestamptz
  profile                 profiles            @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@schema("public")
}
