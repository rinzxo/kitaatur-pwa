generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model profiles {
  id                                                       String                 @id @db.Uuid
  email                                                    String
  full_name                                                String?
  avatar_url                                               String?
  created_at                                               DateTime               @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  global_role                                              user_global_role?      @default(user)
  updated_at                                               DateTime?              @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @db.Timestamptz(6)
  attendance                                               attendance[]
  attendance_records                                       attendance_records[]
  attendance_schedules                                     attendance_schedules[]
  attendance_sessions                                      attendance_sessions[]
  financial_records                                        financial_records[]
  financial_records_financial_records_created_byToprofiles financial_records[]    @relation("financial_records_created_byToprofiles")
  goals                                                    goals[]
  meeting_minutes                                          meeting_minutes[]
  notifications                                            notifications[]
  organization_members                                     organization_members[]
  organizations                                            organizations[]
  users                                                    users                  @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  push_subscriptions                                       push_subscriptions[]
  subscriptions                                            subscriptions[]

  @@schema("public")
}

model organizations {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String                 @unique
  description          String?
  created_at           DateTime               @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  owner_id             String?                @db.Uuid
  logo_url             String?
  updated_at           DateTime?              @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @db.Timestamptz(6)
  dues_target_amount   Decimal?               @db.Decimal(15, 2)
  dues_presets         String?                @default("10000,20000,50000,100000")
  invite_code          String?                @unique
  custom_fields_schema Json?
  is_edu               Boolean?               @default(false)
  edu_pin              String?                @db.VarChar(10)
  attendance           attendance[]
  attendance_schedules attendance_schedules[]
  attendance_sessions  attendance_sessions[]
  financial_records    financial_records[]
  goals                goals[]
  guest_leaves         guest_leaves[]
  meeting_minutes      meeting_minutes[]
  org_guests           org_guests[]
  organization_members organization_members[]
  owner                profiles?              @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model organization_members {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  profile_id      String          @db.Uuid
  role            org_member_role @default(member)
  joined_at       DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  custom_data     Json?
  organization    organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "organization_members_org_id_fkey")
  profile         profiles        @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, profile_id], map: "organization_members_org_id_profile_id_key")
  @@schema("public")
}

model financial_records {
  id                                              String         @id(map: "organization_financials_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                                 String?        @db.Uuid
  amount                                          Decimal        @db.Decimal
  type                                            financial_type
  category                                        String
  description                                     String?
  transaction_date                                DateTime       @db.Date
  receipt_url                                     String?
  created_by                                      String?        @db.Uuid
  created_at                                      DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  profile_id                                      String?        @db.Uuid
  profile                                         profiles?      @relation(fields: [profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_financial_records_created_byToprofiles profiles?      @relation("financial_records_created_byToprofiles", fields: [created_by], references: [id], onUpdate: NoAction, map: "organization_financials_created_by_fkey")
  organization                                    organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "organization_financials_org_id_fkey")

  @@schema("public")
}

model attendance {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String               @db.Uuid
  profile_id      String               @db.Uuid
  status          attendance_status?   @default(present)
  notes           String?
  check_in_time   DateTime?            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  created_at      DateTime?            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  session_id      String?              @db.Uuid
  proof_url       String?
  latitude        Float?
  longitude       Float?
  distance_meters Float?
  check_out_time  DateTime?            @db.Timestamptz(6)
  organization    organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile         profiles             @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session         attendance_sessions? @relation(fields: [session_id], references: [id])

  @@schema("public")
}

model attendance_sessions {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String             @db.Uuid
  created_by          String             @db.Uuid
  title               String             @default("Sesi Absensi")
  session_type        String             @default("in_only")
  pin_code            String             @db.VarChar(10)
  latitude            Float
  longitude           Float
  radius_meters       Int                @default(50)
  start_time          DateTime           @default(now()) @db.Timestamptz(6)
  end_time            DateTime           @default(now()) @db.Timestamptz(6)
  late_time           DateTime?          @db.Timestamptz(6)
  is_active           Boolean            @default(true)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  closed_at           DateTime?          @db.Timestamptz(6)
  checkout_pin_code   String?            @db.VarChar(10)
  checkout_start_time DateTime?          @db.Timestamptz(6)
  shared_with_orgs    String[]           @default([])
  pending_shared_orgs String[]           @default([])
  attendance          attendance[]
  creator             profiles           @relation(fields: [created_by], references: [id])
  organization        organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  guest_attendance    guest_attendance[]
  guest_leaves        guest_leaves[]
  meeting_minutes     meeting_minutes?

  @@schema("public")
}

model meeting_minutes {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String               @db.Uuid
  session_id      String?              @unique @db.Uuid
  title           String
  content         String
  ai_summary      String?
  created_by      String               @db.Uuid
  created_at      DateTime             @default(now()) @db.Timestamptz(6)
  updated_at      DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  author          profiles             @relation(fields: [created_by], references: [id])
  organization    organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  session         attendance_sessions? @relation(fields: [session_id], references: [id])

  @@schema("public")
}

model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String   @db.Uuid
  title      String
  body       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profile    profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model push_subscriptions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profile    profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model goals {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String?             @db.Uuid
  profile_id        String              @db.Uuid
  title             String
  description       String?
  target_amount     Decimal?            @db.Decimal
  current_amount    Decimal?            @default(0) @db.Decimal
  deadline          DateTime?           @db.Date
  status            goal_status?        @default(active)
  created_at        DateTime?           @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  type              String              @default("saving")
  budget_category   String?
  period            String              @default("monthly")
  goal_transactions goal_transactions[]
  organization      organizations?      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile           profiles            @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model goal_transactions {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goal_id     String   @db.Uuid
  profile_id  String   @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  source      String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  description String?
  type        String   @default("income")
  goal        goals    @relation(fields: [goal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile     users    @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model subscriptions {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id              String               @db.Uuid
  pakasir_subscription_id String?              @unique
  status                  subscription_status? @default(active)
  plan_type               String
  amount_paid             Decimal?             @db.Decimal
  starts_at               DateTime             @db.Timestamptz(6)
  expires_at              DateTime             @db.Timestamptz(6)
  created_at              DateTime?            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at              DateTime?            @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @db.Timestamptz(6)
  payment_url             String?
  profile                 profiles             @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model org_guests {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String             @db.Uuid
  name             String
  identifier       String
  qr_token         String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  custom_data      Json?
  guest_attendance guest_attendance[]
  guest_leaves     guest_leaves[]
  organization     organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model guest_attendance {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String              @db.Uuid
  guest_id      String              @db.Uuid
  status        attendance_status   @default(present)
  check_in_time DateTime            @default(now()) @db.Timestamptz(6)
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  guest         org_guests          @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session       attendance_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, guest_id])
  @@schema("public")
}

model attendance_schedules {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  created_by      String        @db.Uuid
  title           String        @default("Sesi Rutin")
  session_type    String        @default("in_only")
  latitude        Float
  longitude       Float
  radius_meters   Int           @default(50)
  days_of_week    Int[]
  start_time      String
  end_time        String
  late_time       String?
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  creator         profiles      @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization    organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model system_settings {
  key         String   @id @db.VarChar
  value       Json
  description String?
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@schema("public")
}

model announcements {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String    @db.VarChar
  content    String
  type       String    @default("info") @db.VarChar
  is_active  Boolean   @default(true)
  starts_at  DateTime? @db.Timestamptz(6)
  ends_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model feature_flags {
  key         String   @id @db.VarChar
  is_enabled  Boolean  @default(false)
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@schema("public")
}

model guest_leaves {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String              @db.Uuid
  guest_id        String              @db.Uuid
  type            String
  notes           String?
  proof_url       String?
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  session_id      String              @db.Uuid
  guest           org_guests          @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization    organizations       @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session         attendance_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

